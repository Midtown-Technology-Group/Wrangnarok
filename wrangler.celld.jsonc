      "name": "wrangnarok-cloudflare-audit-v1",
      "class_name": "CloudflareAuditWorkflow"
    },
    {
      "binding": "CLOUDFLARE_INSIGHTS_WORKFLOW",
      "name": "wrangnarok-cloudflare-insights-v1",
