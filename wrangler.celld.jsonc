      {
        "name": "OAUTH_REFRESH_FENCE",
        "class_name": "OAuthRefreshFence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OAuthRefreshFence"
      ]
    }
  ],
  "workflows": [
    {
      "binding": "ECHO_WORKFLOW",
