    },
    {
      "binding": "DIGEST_WORKFLOW",
      "name": "wrangnarok-ninjaone-echo-digest-v1",
      "class_name": "NinjaEchoDigestWorkflow"
    },
    {
      "binding": "SMOKE_WORKFLOW",
      "name": "wrangnarok-smoke-v1",
      "class_name": "SmokeWorkflow"
    },
    {
      "binding": "HELLO_WORKFLOW",
      "name": "wrangnarok-hello-v1",
      "class_name": "HelloWorkflow"
    },
    {
