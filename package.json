{
  "name": "wrangnarok",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "dev:ui": "vite build --config client/vite.config.ts --watch",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p client && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "node scripts/test-group.mjs unit",
    "test:workflow": "node scripts/test-group.mjs workflow",
    "check:sagas": "vitest run test/saga-contract.test.ts",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build": "npm run build:ui && wrangler deploy --dry-run --env dev",
    "build:dev": "npm run build:ui && wrangler deploy --dry-run --env dev",
    "build:ui": "vite build --config client/vite.config.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --command \"PRAGMA optimize\"",
    "db:optimize:local": "wrangler d1 execute DB --local --command \"PRAGMA optimize\"",
    "db:seed:local": "node scripts/seed-local.mjs",
    "fixture": "node scripts/echo-server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "mailbox": "node scripts/mailbox-cli.mjs",
    "mailbox:selftest": "node scripts/mailbox-cli.mjs selftest",
    "preview:smoke": "node scripts/smoke-preview.mjs",
    "preview:smoke:selftest": "node scripts/smoke-preview.mjs selftest",
    "preview:token": "node scripts/mint-preview-token.mjs",
    "preview:token:selftest": "node scripts/mint-preview-token.mjs selftest"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.8",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
