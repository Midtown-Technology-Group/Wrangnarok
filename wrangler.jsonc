{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wrangnarok-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  // Observability (Workers Logs + traces): sampling 1 while traffic is
  // experiment-scale; revisit before any real load. Retention/quotas follow
  // the account plan — verify vs current Cloudflare pricing before claiming
  // Free-tier headroom for log/trace volume.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./client/dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // NOTE: no credential placeholders here. Empty top-level vars are inherited by
  // every env and would shadow real secrets uploaded via `wrangler secret put`.
  // LAB_TOKEN/LAB_ORG_ID/LAB_USER_ID come from `.dev.vars` locally and from
  // `wrangler secret put --env dev` in dev. NINJA_* are per-Connection secrets.
  "vars": {
    "LAB_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wrangnarok-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // ADR 018: FILE-01 earns the R2 primitive (author/runtime file bytes; D1
  // holds metadata only). ADR 019 (FILE-02 artifacts) reuses the same
  // primitive with a separate binding: FILES carries (org/location/path)
  // objects, ARTIFACTS carries (artifact/version) objects, so keys can never
  // alias across surfaces. Buckets are provisioned per environment via
  // `wrangler r2 bucket create <name>`; local dev/tests use the
  // Miniflare/workerd R2 implementation, never production.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "wrangnarok-local",
    },
    {
      "binding": "ARTIFACTS",
      "bucket_name": "wrangnarok-artifacts-local",
    },
  ],
  "workflows": [
    {
      "binding": "ECHO_WORKFLOW",
      "name": "wrangnarok-echo-v1",
      "class_name": "EchoWorkflow",
    },
    {
      "binding": "NINJA_WORKFLOW",
      "name": "wrangnarok-ninjaone-orgs-v1",
      "class_name": "NinjaOrgsWorkflow",
    },
    {
      "binding": "DIGEST_WORKFLOW",
      "name": "wrangnarok-ninjaone-echo-digest-v1",
      "class_name": "NinjaEchoDigestWorkflow",
    },
    {
      "binding": "SMOKE_WORKFLOW",
      "name": "wrangnarok-smoke-v1",
      "class_name": "SmokeWorkflow",
    },
    {
      "binding": "HELLO_WORKFLOW",
      "name": "wrangnarok-hello-v1",
      "class_name": "HelloWorkflow",
    },
  ],
  // ADR 004 environments: dev is the first deployment target and smoke-test
  // environment with its own mutable resources. Production is intentionally
  // unconfigured/deferred — promotion may be manual until dev is stable.
  "env": {
    "dev": {
      // Dev-only ingress for smoke testing. Production stays without
      // workers_dev/routes until promotion is explicitly designed.
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "dev",
        // LAB_ENABLED is a non-secret kill-switch (NOT a credential): dev
        // API is unreachable rubble without it (authenticate 404s). The
        // actual credentials stay in secrets per the NOTE below.
        "LAB_ENABLED": "true",
        // NOTE: LAB_TOKEN/LAB_ORG_ID/LAB_USER_ID (and NINJA_* when needed)
        // come from `wrangler secret put --env dev` ONLY. Do not add empty
        // placeholders here: empty vars shadow uploaded secrets at runtime.
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Distinct dev database, created 2026-09-09 via
          // `wrangler d1 create wrangnarok-dev`. D1 IDs are not secrets.
          "database_name": "wrangnarok-dev",
          "database_id": "4bcf0eef-45a4-46c1-b80c-1d244ff3076c",
          "migrations_dir": "migrations",
        },
      ],
      // Dev buckets live apart from local ones (never shared).
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "wrangnarok-dev",
        },
        {
          "binding": "ARTIFACTS",
          "bucket_name": "wrangnarok-artifacts-dev",
        },
      ],
      "workflows": [
        {
          "binding": "ECHO_WORKFLOW",
          "name": "wrangnarok-echo-v1-dev",
          "class_name": "EchoWorkflow",
        },
        {
          "binding": "NINJA_WORKFLOW",
          "name": "wrangnarok-ninjaone-orgs-v1-dev",
          "class_name": "NinjaOrgsWorkflow",
        },
        {
          "binding": "DIGEST_WORKFLOW",
          "name": "wrangnarok-ninjaone-echo-digest-v1-dev",
          "class_name": "NinjaEchoDigestWorkflow",
        },
        {
          "binding": "SMOKE_WORKFLOW",
          "name": "wrangnarok-smoke-v1-dev",
          "class_name": "SmokeWorkflow",
        },
        {
          "binding": "HELLO_WORKFLOW",
          "name": "wrangnarok-hello-v1-dev",
          "class_name": "HelloWorkflow",
        },
      ],
    },
    // PR preview environment (ADR 004): one shared disposable Worker on
    // workers.dev plus its own disposable D1. Last-wins across PRs at
    // experiment scale; each run plants an ephemeral LAB_TOKEN and smokes
    // system.smoke against the preview URL. HUMAN SETUP REQUIRED: create
    // the database once (`wrangler d1 create wrangnarok-preview`) and paste
    // its ID below — until then any --env preview command fails closed.
    "preview": {
      "name": "wrangnarok-preview",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "preview",
        "LAB_ENABLED": "true",
        // Demo principal, same non-secret fixture IDs as local tests.
        // LAB_TOKEN alone arrives per run via `wrangler secret put`.
        "LAB_ORG_ID": "00000000-0000-4000-8000-000000000001",
        "LAB_USER_ID": "00000000-0000-4000-8000-000000000002",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wrangnarok-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "wrangnarok-preview",
        },
      ],
      "workflows": [
        {
          "binding": "ECHO_WORKFLOW",
          "name": "wrangnarok-echo-v1-preview",
          "class_name": "EchoWorkflow",
        },
        {
          "binding": "NINJA_WORKFLOW",
          "name": "wrangnarok-ninjaone-orgs-v1-preview",
          "class_name": "NinjaOrgsWorkflow",
        },
        {
          "binding": "DIGEST_WORKFLOW",
          "name": "wrangnarok-ninjaone-echo-digest-v1-preview",
          "class_name": "NinjaEchoDigestWorkflow",
        },
        {
          "binding": "SMOKE_WORKFLOW",
          "name": "wrangnarok-smoke-v1-preview",
          "class_name": "SmokeWorkflow",
        },
        {
          "binding": "HELLO_WORKFLOW",
          "name": "wrangnarok-hello-v1-preview",
          "class_name": "HelloWorkflow",
        },
      ],
    },
  },
}
